---
// Bilingual 404 on a single page (EN on top, ES below): we can't know the visitor's language here.
// No header/footer: their #section links don't exist on this page.
import Base from '../layouts/Base.astro';
import { homePath, useTranslations } from '../i18n/utils';

const en = useTranslations('en');
const es = useTranslations('es');
---

<Base lang="en" title={`${en.notFound.title} — Shaun Nolanh`} noindex>
  <main id="main" class="not-found container">
    <section class="not-found__block" lang="en">
      <h1 class="not-found__title">{en.notFound.title}</h1>
      <p>{en.notFound.text}</p>
      <a class="btn" href={homePath('en')}>{en.notFound.cta}</a>
    </section>

    <section class="not-found__block" lang="es">
      <h2 class="not-found__title">{es.notFound.title}</h2>
      <p>{es.notFound.text}</p>
      <a class="btn" href={homePath('es')}>{es.notFound.cta}</a>
    </section>
  </main>
</Base>

<style>
  .not-found {
    display: grid;
    gap: var(--space-l);
    align-content: center;
    justify-items: center;
    min-height: 100svh;
    padding-block: var(--space-xl);
    text-align: center;
  }

  .not-found__block {
    display: grid;
    gap: var(--space-s);
    justify-items: center;
  }

  .not-found__block + .not-found__block {
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }

  .not-found__title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  p {
    color: var(--text-70);
  }
</style>
