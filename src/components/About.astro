---
import { Picture } from 'astro:assets';
import portrait from '../assets/photos/shaun-retrato.jpg';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// The full bio, in its three paragraphs. The short version (`about.short`) repeats its first lines,
// so it isn't shown here; it stays in i18n for the press kit / future use.
const paragraphs = t.about.long;
---

<section class="section section--alt" id="about" aria-labelledby="about-title">
  <div class="container container--5xl">
    <h2 class="section__title reveal" id="about-title">{t.about.title}</h2>
    <div class="about">
      <Picture
        class="about__photo reveal"
        src={portrait}
        formats={['avif', 'webp']}
        widths={[480, 720, 960]}
        sizes="(min-width: 64rem) 24rem, (min-width: 48rem) 40vw, 100vw"
        alt={t.about.photoAlt}
        loading="lazy"
      />
      <div class="about__bio reveal">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-l);
  }

  /* Portrait crop of the landscape photo, centered on the face */
  .about :global(.about__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    max-height: 32rem;
    object-fit: cover;
    object-position: 50% 45%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .about__bio {
    display: grid;
    gap: var(--space-m);
    color: var(--text-70);
    font-size: var(--text-lg);
    line-height: 1.8;
  }

  /* Desktop: photo + text in two columns */
  @media (min-width: 48rem) {
    .about {
      grid-template-columns: 2fr 3fr;
      align-items: start;
    }

    .about :global(.about__photo) {
      max-height: none;
    }

    .about__bio {
      font-size: var(--text-xl);
    }
  }
</style>
