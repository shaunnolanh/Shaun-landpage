---
import SpotifyPlayer from './SpotifyPlayer.astro';
import TrackCarousel from './TrackCarousel.astro';
import { beatportProfile, upcoming } from '../data/music';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id="music" aria-labelledby="music-title">
  <div class="container container--4xl music">
    <header class="section__head reveal">
      <h2 class="section__title" id="music-title">{t.music.title}</h2>
      <p class="section__lead">{t.music.lead}</p>
    </header>

    <div class="music__tracks">
      <TrackCarousel lang={lang} />
      <SpotifyPlayer lang={lang} />
    </div>

    <h3 class="music__subtitle reveal">{t.music.releases}</h3>
    <ul class="releases">
      {
        upcoming.map((r) => (
          <li class="release">
            <div class="release__main">
              <p class="release__title">{t.music.unreleased}</p>
              <p class="release__artists">{r.artists}</p>
            </div>
            <div class="release__meta">
              <span class="pill">{t.music.upcoming}</span>
            </div>
          </li>
        ))
      }
    </ul>
    <a class="releases__all mono" href={beatportProfile} target="_blank" rel="noopener">
      {t.music.allOnBeatport} <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<script>
  // Time-based cascade, so it runs on IntersectionObserver in every browser (scroll timelines have no milliseconds).
  import { reveal } from '../scripts/reveal';
  // Each row's position for the cascade delay, set here (an inline `style` attribute would break the CSP)
  document.querySelectorAll<HTMLElement>('.release').forEach((row, i) => row.style.setProperty('--i', String(i)));
  reveal('.release');
</script>

<style>
  .music__tracks {
    margin-bottom: var(--space-xl);
  }

  .music__subtitle {
    margin-bottom: var(--space-m);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-align: center;
    text-transform: uppercase;
    color: var(--text-60);
  }

  .releases {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .release {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--line);
  }

  /* Cascade: hidden only once JS has added data-reveal; 80ms between rows, capped at 400ms */
  .release[data-reveal] {
    opacity: 0;
    transform: translateY(0.75rem);
  }

  /* The transition lives on the visible state: hiding is instant (no fade-out on load), showing is animated */
  .release[data-reveal].is-visible {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.8s var(--ease-out);
    transition-delay: min(calc(var(--i) * 80ms), 400ms);
  }

  /* A white line draws itself left to right under the row on hover / keyboard focus inside it */
  .release::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--line-hover);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.6s var(--ease-out);
  }

  .release:hover::after,
  .release:focus-within::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .release::after {
      transition: none;
    }
  }

  .release__title {
    font-weight: 600;
  }

  .releases__all {
    display: block;
    width: fit-content;
    margin: var(--space-m) auto 0;
    padding-block: 0.5rem;
    color: var(--text-70);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-underline-offset: 0.25em;
    transition: color var(--duration) var(--ease);
  }

  .releases__all:hover {
    color: var(--text);
  }

  .release__artists {
    color: var(--text-70);
  }

  .release__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
    color: var(--text-60);
  }

  @media (min-width: 48rem) {
    .release {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
