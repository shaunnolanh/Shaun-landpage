---
import { homePath, languages, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<ul class="lang" aria-label={t.nav.language}>
  {
    (Object.keys(languages) as Lang[]).map((l) => (
      <li>
        <a href={homePath(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
          {languages[l]}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .lang {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
  }

  a {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--text-70);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: color var(--duration) var(--ease);
  }

  a:hover {
    color: var(--text);
  }

  a[aria-current='true'] {
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
</style>
