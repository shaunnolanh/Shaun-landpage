---
import Embed from './Embed.astro';
import { sets } from '../data/music';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section section--alt" id="sets" aria-labelledby="sets-title">
  <div class="container container--4xl">
    <header class="reveal">
      <h2 class="section__title" id="sets-title">{t.sets.title}</h2>
      <p class="section__lead">{t.sets.lead}</p>
    </header>
    <!-- One set per row, full width (SoundCloud's visual player, 300px tall), each in its own frame -->
    <ol class="sets">
      {
        sets.map((set) => (
          <li class="set reveal">
            <Embed embed={set} lang={lang} />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .sets {
    display: grid;
    gap: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .set {
    padding: var(--space-s);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-2xl);
    background: color-mix(in srgb, var(--black) 40%, transparent);
  }
</style>
