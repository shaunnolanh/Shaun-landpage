---
// Player embed: the SoundCloud/Spotify/Mixcloud/Beatport iframe, right in the HTML (it shows up loaded,
// no click needed). In controlled mode it's a placeholder button instead (see `controlled`).
import type { Embed } from '../data/music';
import { toEmbed } from '../data/embed';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  embed: Embed;
  lang: Lang;
  /**
   * Controlled mode: a placeholder button instead of the iframe. Another script owns the player
   * (the Music carousel + Spotify iFrame API) and swaps it in; a click on the button means "play".
   */
  controlled?: { name: string; height: number };
}

const { embed, lang, controlled } = Astro.props;
const t = useTranslations(lang);
// Whatever was pasted in `link` becomes { provider, src, height }; unknown links stop the build.
const player = controlled ? { ...controlled, src: undefined, provider: undefined } : embed.link ? toEmbed(embed.link) : null;
const height = player?.height ?? 166;
const title = embed.title ?? `${player?.name ?? ''} player`.trim();
---

<div class="embed">
  {
    player?.src ? (
      <iframe src={player.src} title={title} width="100%" height={height} allow="autoplay; encrypted-media" />
    ) : player ? (
      <button class="embed__play" type="button" data-embed-controlled>
        <span class="embed__icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 12 12"><path d="M2 1l9 5-9 5z" fill="currentColor" /></svg>
        </span>
        <span class="embed__text">
          <span class="embed__title">{embed.title ?? t.embed.play}</span>
          <span class="mono embed__note">{t.embed.loadNotice} {player.name}</span>
        </span>
        <span class="visually-hidden">{t.embed.play}</span>
      </button>
    ) : (
      <p class="embed__pending">
        <span class="pending">[EMBED PENDIENTE]</span>
      </p>
    )
  }
</div>

<style>
  /* No inline `style` (the CSP doesn't allow it): an iframe reserves its height with its `height` attribute;
     the controlled facade gets --embed-h from SpotifyPlayer's script (166px until then). */
  .embed {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--black);
    overflow: hidden;
    transition: border-color var(--duration) var(--ease);
  }

  .embed:hover {
    border-color: var(--line-strong);
  }

  .embed :global(iframe) {
    display: block;
    width: 100%;
    border: 0;
  }

  .embed__play {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    width: 100%;
    min-height: var(--embed-h, 166px);
    padding: var(--space-m);
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  /* White play button, black triangle */
  .embed__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--white);
    color: var(--black);
    transition:
      transform var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .embed__play:hover .embed__icon {
    transform: scale(1.05);
    background: var(--text-80);
  }

  .embed__text {
    display: grid;
    gap: 0.25rem;
  }

  .embed__title {
    font-weight: 600;
  }

  .embed__note {
    color: var(--text-60);
  }

  .embed__pending {
    display: grid;
    place-items: center;
    min-height: 166px;
    padding: var(--space-m);
  }
</style>
