---
import { site } from '../data/site';
import type { HeroImage } from '../lib/hero-image';
import { heroSizes } from '../lib/hero-image';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Same files the page head preloads (see HomePage) */
  image: HeroImage;
}

const { lang, image } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <picture>
      <source type="image/avif" srcset={image.avif.srcSet.attribute} sizes={heroSizes} />
      <source type="image/webp" srcset={image.webp.srcSet.attribute} sizes={heroSizes} />
      <img
        src={image.jpeg.src}
        srcset={image.jpeg.srcSet.attribute}
        sizes={heroSizes}
        width={image.width}
        height={image.height}
        alt={t.hero.photoAlt}
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    {
      /* Optional background video over the photo; the photo stays as poster and as the reduced-motion view */
      site.heroVideo && (
        <video class="hero__video" autoplay muted loop playsinline preload="metadata" poster={image.jpeg.src} aria-hidden="true">
          <source src={site.heroVideo} type="video/mp4" />
        </video>
      )
    }
  </div>

  <div class="hero__content container">
    <h1 class="hero__title" id="hero-title">Shaun Nolanh</h1>
    <p class="hero__tagline">{t.hero.tagline}</p>
    <!-- With JS it opens the booking dialog (BookingDialog); without JS it goes to the booking email in Contact -->
    <a class="btn btn--solid hero__cta" href="#contact" data-open-booking>{t.hero.book}</a>
  </div>
</section>

<style>
  /* Full screen; name, tagline and button in the lower part so they never cover the face */
  .hero {
    position: relative;
    display: grid;
    align-content: end;
    min-height: 100svh;
    padding-block: 6rem clamp(4rem, 12svh, 8rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--black);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media img,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Mobile (portrait crop): keep the face, a bit right of center and in the upper third */
    object-position: 55% 35%;
  }

  /* Black at 60% → 40% → solid at the bottom, so the name reads and the hero melts into the page */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--black) 60%, transparent),
      color-mix(in srgb, var(--black) 40%, transparent) 45%,
      var(--black)
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .hero__media img,
    .hero__video {
      object-position: 50% 30%;
    }
  }

  .hero__content {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    text-align: center;
  }

  .hero__title {
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: var(--tracking-tighter);
    text-transform: uppercase;
  }

  .hero__tagline {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-80);
  }

  @media (min-width: 48rem) {
    .hero__tagline {
      font-size: var(--text-lg);
    }
  }

  .hero__cta {
    margin-top: var(--space-m);
    min-width: 12rem;
    min-height: 3.5rem;
    font-size: var(--text-base);
  }
</style>
