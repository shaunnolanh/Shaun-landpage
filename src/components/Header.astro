---
import LangSwitch from './LangSwitch.astro';
import { homePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const links = [
  { href: '#about', label: t.nav.about },
  { href: '#music', label: t.nav.music },
  { href: '#sets', label: t.nav.radioSilence },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="header">
  <div class="header__bar container">
    <a class="header__logo" href={homePath(lang)}>Shaun Nolanh</a>

    <nav class="header__nav" id="site-nav" aria-label={t.nav.label}>
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__tools">
      <LangSwitch lang={lang} />
      <button
        class="header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-label-open={t.nav.menuOpen}
        data-label-close={t.nav.menuClose}
      >
        <span class="visually-hidden">{t.nav.menuOpen}</span>
        <span class="header__burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Transparent over the hero, solid past 20px of scroll; mobile menu; active section.
  // Without JS the header is solid all the time (readable anywhere) and the anchors still work.
  const header = document.querySelector<HTMLElement>('.header');
  const toggle = header?.querySelector<HTMLButtonElement>('.header__toggle');
  const nav = header?.querySelector<HTMLElement>('.header__nav');

  if (header && toggle && nav) {
    header.dataset.js = 'true';
    const label = toggle.querySelector('.visually-hidden')!;

    const setScrolled = () => header.toggleAttribute('data-scrolled', window.scrollY > 20);
    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!;
      header.toggleAttribute('data-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Active section: the link of the section crossing the middle of the viewport gets aria-current.
    const links = new Map(
      [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')].map((a) => [a.hash.slice(1), a]),
    );
    const sections = [...links.keys()].flatMap((id) => document.getElementById(id) ?? []);
    if ('IntersectionObserver' in window) {
      // Sections touching a thin band around the middle of the viewport. If two touch it at a boundary,
      // the later one in the page wins (it's the one being scrolled into), so only one link is ever marked.
      const inBand = new Set<Element>();
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) inBand.add(entry.target);
            else inBand.delete(entry.target);
          }
          const active = sections.filter((section) => inBand.has(section)).at(-1);
          for (const section of sections) {
            const link = links.get(section.id);
            if (section === active) link?.setAttribute('aria-current', 'true');
            else link?.removeAttribute('aria-current');
          }
        },
        { rootMargin: '-47% 0px -52% 0px' },
      );
      sections.forEach((section) => sectionObserver.observe(section));
    }
  }
</script>

<style>
  /* Fixed on top. Solid by default (no JS); with JS, transparent until 20px of scroll. */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--black) 95%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .header[data-js]:not([data-scrolled]):not([data-open]) {
    border-bottom-color: transparent;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 4.5rem;
  }

  .header__logo {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .header__logo {
      font-size: var(--text-xl);
    }
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .header__nav a {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-70);
    transition: color var(--duration) var(--ease);
  }

  .header__nav a:hover,
  .header__nav a[aria-current='true'] {
    color: var(--text);
  }

  .header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .header__burger,
  .header__burger::before {
    display: block;
    width: 1.4rem;
    height: 1.5px;
    margin-inline: auto;
    background: var(--text);
    transition: transform var(--duration) var(--ease);
  }

  .header__burger {
    transform: translateY(-4px);
  }

  .header__burger::before {
    content: '';
    transform: translateY(8px);
  }

  [data-open] .header__burger {
    transform: rotate(45deg);
  }

  [data-open] .header__burger::before {
    transform: rotate(-90deg);
  }

  /* Mobile: the nav drops down under the bar, behind the toggle (only when JS is running). */
  @media (max-width: 47.99rem) {
    .header__nav ul {
      gap: var(--space-m);
    }

    .header[data-js] .header__toggle {
      display: block;
    }

    .header[data-js] .header__nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      padding: var(--space-m) var(--gutter) var(--space-l);
      border-bottom: 1px solid var(--line);
      background: color-mix(in srgb, var(--black) 95%, transparent);
    }

    .header[data-js][data-open] .header__nav {
      display: block;
    }

    .header[data-js] .header__nav ul {
      flex-direction: column;
      gap: 0;
    }

    .header[data-js] .header__nav a {
      display: block;
      padding-block: 0.75rem;
      font-size: var(--text-base);
    }

    /* Without JS: hide the inline nav to avoid overflow; the anchors and the footer still work. */
    .header:not([data-js]) .header__nav {
      display: none;
    }
  }
</style>
