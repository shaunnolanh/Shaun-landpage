# Web3Forms access key (https://web3forms.com). Copy this file to .env and fill it in.
# It's public by design (it only allows sending to the email it was created for),
# but we keep it out of the code so it can change without touching components.
PUBLIC_WEB3FORMS_KEY=

# Public URL of the site, without a trailing slash. On Cloudflare Pages (Settings → Variables):
# https://shaun-landpage.pages.dev until the real domain exists. Locally, leave it empty: it falls back
# to http://localhost:4321.
SITE_URL=

# Cloudflare Pages also needs NODE_VERSION=24 in its variables (same as .node-version).
